                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedHost\": {\n    \"distributionId\": \"<string>\",\n    \"type\": \"<string>\"\n  },\n  \"attendees\": [\n    {\n      \"userId\": \"<string>\",\n      \"required\": \"<boolean>\",\n      \"type\": \"<string>\"\n    }\n  ],\n  \"meetingTypeRef\": {\n    \"id\": \"<uuid>\",\n    \"timestamp\": \"<dateTime>\"\n  },\n  \"interval\": {\n    \"startsAt\": \"<dateTime>\",\n    \"duration\": \"<string>\"\n  },\n  \"meetingTypeOverride\": {\n    \"meetingDurationOverride\": \"<string>\",\n    \"beforeBufferDurationOverride\": \"<string>\",\n    \"afterBufferDurationOverride\": \"<string>\",\n    \"availabilityIncrementOverride\": \"<string>\"\n  }\n}",
              "options": {
